// Cloudflare Workers Builds runs `bundle exec jekyll build` and then deploys with this file (README.md has the rest).
{
  // Must match the Worker's name in the Cloudflare dashboard, or the build refuses to deploy.
  "name": "folino-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    // The Worker sees `/` and nothing else; every other request is a static file.
    "run_worker_first": ["/"],
    // An address with no file gets _site/404.html with a 404, not the home page.
    "not_found_handling": "404-page",
    // `/faq/en` redirects to `/faq/en/` (with a 307, where GitHub Pages sent a 301).
    "html_handling": "auto-trailing-slash"
  }
}
