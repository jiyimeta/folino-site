# Response headers for the static files (worker/index.js sets its own for `/`). The Worker's workers.dev address and
# each preview's address serve the same pages as folino.app; only folino.app is to be indexed.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex

https://:preview.:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
